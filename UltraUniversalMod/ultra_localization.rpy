    def ultra_t(key):
        """Read an Ultra-only UI key with Russian fallback."""
        pair = ULTRA_UI_TEXT.get(key)
        if pair is None:
            return key
        if getattr(persistent, "ultra_ui_language", "ru") == "en" and pair[1]:
            return pair[1]
        return pair[0]

    def ultra_ui_t(key):
        """Protect Ultra's English screen labels from the host game's text replacements."""
        value = ultra_t(key)
        if getattr(persistent, "ultra_ui_language", "ru") == "en":
            return _ultra_ui_re.sub(r"(?<=[A-Za-z])(?=[A-Za-z])", "\u2060", value)
        return value

    def ultra_set_ui_language(language):
        if language not in ("ru", "en") or language == getattr(persistent, "ultra_ui_language", "ru"):
            return
        persistent.ultra_ui_language = language
        renpy.save_persistent()
        renpy.restart_interaction()
